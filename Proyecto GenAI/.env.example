DOCUMENTS_DIR=Documentos
DATA_DIR=data
PROCESSED_DIR=data/processed
EVAL_DIR=data/eval
CHUNKS_DIR=data/chunks
CHUNKS_FILE=data/chunks/chunks.jsonl
STORAGE_DIR=storage
CHROMA_DIR=storage/chroma
CHROMA_COLLECTION_NAME=documents
MANIFEST_DB_PATH=storage/manifest.sqlite
LOG_DIR=logs
LOG_LEVEL=INFO

EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16

CHUNK_SIZE=1200
CHUNK_OVERLAP=200
MIN_CHUNK_SIZE=200
TOP_K=3
MIN_RETRIEVAL_SCORE=0.84
SNIPPET_MAX_CHARS=400
MIN_CONTEXT_CHARS=500
MAX_CONTEXT_CHARS=6000
MAX_SOURCES=3
EVAL_DATASET_PATH=data/eval/evaluation_questions.jsonl
EVAL_REPORTS_DIR=data/eval/reports
EVAL_ANSWER_PREVIEW_CHARS=300

ALLOW_EXTERNAL_LLM=false
LLM_PROVIDER=none

API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=false
API_INCLUDE_DEBUG_ERRORS=false
API_BASE_URL=http://127.0.0.1:8000
